# Websocket server for ODII chat.
#
# Mirrors odii_backend.service exactly (same user, dir, venv) so it behaves
# identically. Runs ASGI via daphne on 8002; gunicorn keeps WSGI on 8001.
# daphne 4.2.1 is already installed in the venv.
#
# Bound to 127.0.0.1 only - nginx proxies /ws/ to it. Never expose directly.
#
# Install: cp to /etc/systemd/system/ then
#   systemctl daemon-reload && systemctl enable --now odii_daphne

[Unit]
Description=ODII Daphne ASGI (websockets)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
User=root
Group=root
WorkingDirectory=/root/odii_backend/ODI-App-Backend
Environment="PATH=/root/odii_backend/ODI-App-Backend/venv/bin"
ExecStart=/root/odii_backend/ODI-App-Backend/venv/bin/daphne \
  -b 127.0.0.1 \
  -p 8002 \
  ODI.asgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
